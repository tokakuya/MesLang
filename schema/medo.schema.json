{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meslang.dev/schema/medo.schema.json",
  "title": "Medo",
  "description": "MesLang の中間データ（medo/0.0）。実験的で破壊的変更があり得る。形チェックは箱の名前と型だけを見る（話の良し悪しは見ない）。空の sections / pieces / decorators、空の dialogue、attrs: {} は正しい縁。必須箱の欠け（dialogue キーなし、rawMark なしなど）は弾く。空の header・profile なし・追加の文字列キーは正しい。空文字や未知の profile は弾く。ピース直下の attrs は弾く。kind unknown は手組み用の逃げ道。原稿の必須（ほぼゼロ）と箱の必須は別。",
  "type": "object",
  "required": ["version", "header", "body"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "medo/0.0"
    },
    "header": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "raw": { "type": "string" },
        "profile": {
          "type": "string",
          "enum": ["audio", "manga", "anime", "vn", "unknown"]
        },
        "title": { "type": "string" }
      }
    },
    "body": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["title", "pieces"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "pieces": {
          "type": "array",
          "items": { "$ref": "#/$defs/piece" }
        }
      }
    },
    "piece": {
      "type": "object",
      "required": ["dialogue", "decorators"],
      "additionalProperties": false,
      "properties": {
        "dialogue": { "type": "string" },
        "decorators": {
          "type": "array",
          "items": { "$ref": "#/$defs/decorator" }
        }
      }
    },
    "decorator": {
      "type": "object",
      "required": ["kind", "rawMark", "value", "attrs"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "comment",
            "sound",
            "position",
            "timing",
            "ext",
            "frame",
            "camera",
            "beat",
            "unknown"
          ],
          "description": "unknown は手組み Medo などの逃げ道。参照パーサは表に無い行頭を kind にせずセリフ行へ残す。"
        },
        "rawMark": {
          "type": "string",
          "description": "原稿上の記号（半角・全角をそのまま保持）。参照パーサは常に出力する。"
        },
        "value": { "type": "string" },
        "attrs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
